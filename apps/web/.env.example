# NextAuth (Auth.js v5) — required for production
# Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Identity service — used server-side in src/auth.ts authorize()
# In Docker/Kubernetes use the internal service name: http://identity:3001
IDENTITY_SERVICE_URL=http://localhost:3001

# Backend API — used client-side in src/lib/api/client.ts
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Socket.IO URL — used by realtime-context.tsx for WebSocket connections.
# REQUIRED in production if the backend is on a different domain/port than the API.
# Falls back to NEXT_PUBLIC_API_BASE_URL when not set — set explicitly to avoid WS failures
# behind a reverse proxy that doesn't transparently forward the /socket.io/ upgrade.
# Example for app.raycraft.in (backend served at same origin via proxy):
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Public feature flags
# Set to false to use real backend APIs instead of mock data
NEXT_PUBLIC_USE_MOCKS=false
