# NextAuth (Auth.js v5) — required for production
# Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Identity service — used server-side in src/auth.ts authorize()
# In Docker/Kubernetes use the internal service name: http://identity:3001
IDENTITY_SERVICE_URL=http://localhost:3001

# Backend API — used client-side in src/lib/api/client.ts
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Public feature flags
# Set to false to use real backend APIs instead of mock data
NEXT_PUBLIC_USE_MOCKS=false
